<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Nico Egerer</Authors>
    <Company>Nico Egerer</Company>
    <Product>Image Converter</Product>
    <Description>Lokale Windows-App zum Zuschneiden, Skalieren, Konvertieren und Optimieren von Bildern.</Description>
    <Copyright>Copyright © 2026 Nico Egerer</Copyright>
    <Version>1.1.1</Version>
    <RepositoryUrl>https://github.com/nicoegerer/ImageConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nicoegerer/ImageConverter</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
