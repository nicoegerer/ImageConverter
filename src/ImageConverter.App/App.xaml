<Application
    x:Class="ImageConverter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppLayerBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#454545" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#C9C9C9" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#C15BD5" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB7F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppLayerBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#454545" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#C9C9C9" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#C15BD5" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB7F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppLayerBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D7D7D7" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#9A3DB0" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#167A2D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
