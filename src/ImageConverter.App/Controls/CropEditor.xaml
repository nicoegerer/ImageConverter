<UserControl
    x:Class="ImageConverter.App.Controls.CropEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="Viewport"
        Background="#171717"
        IsTabStop="True"
        KeyDown="OnKeyDown"
        PointerCanceled="OnPointerCanceled"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerWheelChanged="OnPointerWheelChanged"
        SizeChanged="OnViewportSizeChanged">

        <Image
            x:Name="PreviewImage"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ImageOpened="OnImageOpened"
            Stretch="Uniform" />

        <Canvas
            x:Name="OverlayCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False">
            <Rectangle x:Name="TopMask" Fill="#88000000" />
            <Rectangle x:Name="LeftMask" Fill="#88000000" />
            <Rectangle x:Name="RightMask" Fill="#88000000" />
            <Rectangle x:Name="BottomMask" Fill="#88000000" />

            <Rectangle
                x:Name="CropBorder"
                Fill="Transparent"
                Stroke="{ThemeResource AppAccentBrush}"
                StrokeThickness="2" />
            <Line x:Name="ThirdV1" Stroke="#99FFFFFF" StrokeThickness="1" />
            <Line x:Name="ThirdV2" Stroke="#99FFFFFF" StrokeThickness="1" />
            <Line x:Name="ThirdH1" Stroke="#99FFFFFF" StrokeThickness="1" />
            <Line x:Name="ThirdH2" Stroke="#99FFFFFF" StrokeThickness="1" />

            <Ellipse x:Name="HandleTopLeft" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleTop" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleTopRight" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleRight" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleBottomRight" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleBottom" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleBottomLeft" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />
            <Ellipse x:Name="HandleLeft" Width="14" Height="14" Fill="White" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" />

            <Border
                x:Name="CropLabel"
                Background="#DD111111"
                CornerRadius="5"
                Padding="8,4">
                <TextBlock
                    x:Name="CropLabelText"
                    Foreground="White"
                    Text="4:7 · 600 × 1050" />
            </Border>
        </Canvas>

        <Border
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#CC222222"
            CornerRadius="10"
            Padding="24,18">
            <StackPanel Spacing="8">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="White"
                    Glyph="&#xEB9F;" />
                <TextBlock
                    Foreground="White"
                    Text="Wähle links ein Bild aus"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border
            x:Name="HintBar"
            Margin="16"
            Padding="12,7"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#DD202020"
            CornerRadius="7"
            Visibility="Collapsed">
            <TextBlock
                Foreground="White"
                Text="Rahmen oder Griffe ziehen · Mausrad · Pfeile / WASD · R zurücksetzen" />
        </Border>
    </Grid>
</UserControl>
