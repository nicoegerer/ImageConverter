<Window
    x:Class="ImageConverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageConverter.App.Controls"
    Title="Image Converter">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource AppBackgroundBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,132,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Border Width="30" Height="30" Background="#C15BD5" CornerRadius="8">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="White"
                        Glyph="&#xEB9F;" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Image Converter" />
                <Border Padding="7,3" Background="{ThemeResource AppCardBrush}" CornerRadius="5">
                    <TextBlock FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="1.0" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddFilesClick" ToolTipService.ToolTip="Bilder auswählen (Strg+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Name="HeaderAddText" Text="Bilder hinzufügen" />
                    </StackPanel>
                </Button>
                <Button x:Name="HeaderFolderButton" Click="OnAddFolderClick" ToolTipService.ToolTip="Kompletten Ordner öffnen">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock Text="Ordner" />
                    </StackPanel>
                </Button>
                <Button x:Name="HeaderExportButton" Background="#C15BD5" Click="OnExportSelectedClick" Foreground="White" ToolTipService.ToolTip="Ausgewählte Bilder exportieren (Strg+E)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" />
                        <TextBlock Text="Exportieren" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="TopNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Crop &amp; Resize" Icon="Crop" Tag="crop" />
                <NavigationViewItem Content="Convert" Icon="Switch" Tag="convert" />
                <NavigationViewItem Content="Optimize" Icon="Repair" Tag="optimize" />
                <NavigationViewItem Content="Rename" Icon="Rename" Tag="rename" />
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="12,0,12,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImagesColumn" Width="325" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                <ColumnDefinition x:Name="OptionsColumn" Width="375" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Bilder" />
                            <TextBlock x:Name="SelectionCountText" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="0 ausgewählt" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnClearListClick" ToolTipService.ToolTip="Liste leeren">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,12" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSelectAllClick" Content="Alle auswählen" />
                        <Button Click="OnSelectNoneClick" Content="Auswahl aufheben" />
                    </StackPanel>
                    <ListView
                        x:Name="ImageList"
                        Grid.Row="2"
                        IsItemClickEnabled="True"
                        ItemClick="OnImageItemClick"
                        ItemsSource="{x:Bind Images, Mode=OneWay}"
                        SelectionMode="Single"
                        ContainerContentChanging="OnImageContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <Border Grid.Column="1" Width="96" Height="70" Background="#171717" CornerRadius="7">
                                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FileName}" />
                                        <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding MetadataLine}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding FileSizeText}" />
                                        <TextBlock Foreground="{ThemeResource AppSuccessBrush}" Text="{Binding LastExportText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="SemiBold" Text="Vorschau" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewSubtitle" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Wähle ein Bild aus" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnUndoClick" ToolTipService.ToolTip="Rückgängig (Strg+Z)"><FontIcon Glyph="&#xE7A7;" /></Button>
                            <Button Click="OnRedoClick" ToolTipService.ToolTip="Wiederholen (Strg+Y)"><FontIcon Glyph="&#xE7A6;" /></Button>
                            <Button Click="OnResetCropClick" ToolTipService.ToolTip="Crop zurücksetzen (R)"><FontIcon Glyph="&#xE72C;" /></Button>
                        </StackPanel>
                    </Grid>
                    <controls:CropEditor x:Name="CropEditor" Grid.Row="1" MinHeight="340" CropChanged="OnCropChanged" />
                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8A3;" />
                        <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="50" Maximum="400" StepFrequency="1" Value="100" ValueChanged="OnZoomSliderChanged" />
                        <TextBlock x:Name="ZoomValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100 %" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="ExportScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="ExportPanel" Spacing="10">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Export" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Vor dem Start werden Zielnamen und Einstellungen bestätigt." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Preset" />
                            <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Verarbeitung" />
                            <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Bildgröße" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="WidthBox" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeChanged" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Text="×" />
                                <NumberBox x:Name="HeightBox" Grid.Column="2" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeChanged" />
                            </Grid>
                            <TextBlock x:Name="CropSizeHint" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Der Crop übernimmt das Verhältnis dieser Zielgröße." TextWrapping="Wrap" />
                            <CheckBox x:Name="AspectLockCheck" Checked="OnAspectLockChanged" Content="Seitenverhältnis sperren" Unchecked="OnAspectLockChanged" />
                            <CheckBox x:Name="PreventUpscaleCheck" Click="OnExportSettingChanged" Content="Nicht vergrößern, wenn Original kleiner ist" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Ausgabeformat" />
                            <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" SelectionChanged="OnExportSettingChanged" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Qualität / Kompression" />
                                <NumberBox x:Name="QualityBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnQualityBoxChanged" />
                            </Grid>
                            <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" StepFrequency="1" ValueChanged="OnQualitySliderChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="OnQualityPresetClick" Content="Small" Tag="75" />
                                <Button Click="OnQualityPresetClick" Content="Balanced" Tag="85" />
                                <Button Click="OnQualityPresetClick" Content="High" Tag="95" />
                                <Button Click="OnQualityPresetClick" Content="Maximum" Tag="100" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Metadaten" />
                            <ComboBox x:Name="MetadataCombo" HorizontalAlignment="Stretch" SelectionChanged="OnExportSettingChanged" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Dateinamen" />
                            <ComboBox x:Name="NamingModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnNamingModeChanged" />
                            <Grid x:Name="NamingFields" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="NamingPrefixBox" Header="Präfix" TextChanged="OnExportSettingChanged" />
                                <NumberBox x:Name="NamingStartBox" Grid.Column="1" Header="Start" Minimum="0" ValueChanged="OnExportSettingChanged" />
                                <NumberBox x:Name="NamingLengthBox" Grid.Column="2" Header="Stellen" Minimum="1" Maximum="8" ValueChanged="OnExportSettingChanged" />
                            </Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Zielordner" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="DestinationBox" IsReadOnly="True" />
                                <Button Grid.Column="1" Click="OnChooseDestinationClick" ToolTipService.ToolTip="Zielordner wählen"><FontIcon Glyph="&#xE8B7;" /></Button>
                            </Grid>
                            <Border Margin="0,8,0,0" Padding="14" Background="{ThemeResource AppLayerBrush}" CornerRadius="9">
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="OutputSummaryText" FontWeight="SemiBold" Text="Voraussichtliche Ausgabe" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Original" /><TextBlock x:Name="OriginalSizeText" Grid.Column="1" Text="–" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Export" /><TextBlock x:Name="EstimatedSizeText" Grid.Column="1" Text="–" /></Grid>
                                    <TextBlock x:Name="EstimateHintText" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button HorizontalAlignment="Stretch" Background="#C15BD5" Click="OnExportSelectedClick" Content="Ausgewählte exportieren" Foreground="White" />
                            <Button HorizontalAlignment="Stretch" Click="OnExportAllClick" Content="Alle exportieren" />
                            <Button x:Name="CancelExportButton" HorizontalAlignment="Stretch" Click="OnCancelExportClick" Content="Abbrechen" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="RenameScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Umbenennen" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Änderungen werden immer zuerst als Vorschau angezeigt." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Einzelne Datei" />
                            <TextBox x:Name="SingleRenameBox" Header="Neuer Dateiname" />
                            <Button HorizontalAlignment="Stretch" Click="OnPreviewSingleRenameClick" Content="Einzelvorschau" />
                            <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource AppBorderBrush}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Automatische Nummerierung" />
                            <TextBox x:Name="RenamePrefixBox" Header="Präfix" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <NumberBox x:Name="RenameStartBox" Header="Startnummer" Minimum="0" />
                                <NumberBox x:Name="RenameLengthBox" Grid.Column="1" Header="Nummernlänge" Minimum="1" Maximum="8" />
                            </Grid>
                            <ComboBox x:Name="RenameSortCombo" Header="Reihenfolge" HorizontalAlignment="Stretch" />
                            <Button HorizontalAlignment="Stretch" Background="#C15BD5" Click="OnPreviewRenameClick" Content="Vorschau erstellen" Foreground="White" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Einstellungen" />
                            <ComboBox x:Name="ThemeCombo" Header="Darstellung" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" />
                            <NumberBox x:Name="ParallelismBox" Header="Parallele Export-Jobs" Maximum="8" Minimum="1" SpinButtonPlacementMode="Compact" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Bei sehr großen HEIC-Dateien sind 2–4 parallele Jobs meist sinnvoll." TextWrapping="Wrap" />
                            <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource AppBorderBrush}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Diagnose" />
                            <Button HorizontalAlignment="Stretch" Click="OnOpenLogsClick" Content="Log-Ordner öffnen" />
                            <Button HorizontalAlignment="Stretch" Click="OnOpenDiagnosticsClick" Content="Diagnose-Ordner öffnen" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Padding="16,0" Background="{ThemeResource AppCardBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" Margin="0,0,10,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Bereit" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="ExportProgressBar" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <Button x:Name="ResultsButton" Grid.Column="3" Padding="10,4" Click="OnShowResultsClick" Visibility="Collapsed">
                <TextBlock x:Name="ResultsButtonText" Text="Ergebnisse" />
            </Button>
        </Grid>
    </Grid>
</Window>
