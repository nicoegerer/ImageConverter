<Window
    x:Class="ImageConverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImageConverter.App.Controls"
    Title="Nico Image Converter">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource AppBackgroundBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop"
        KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,132,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Border Width="32" Height="32" Background="{ThemeResource AppAccentBrush}" CornerRadius="9">
                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Foreground="White" Glyph="&#xEB9F;" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Nico Image Converter" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Bilder lokal bearbeiten und exportieren" />
                </StackPanel>
                <Border Padding="7,3" Background="{ThemeResource AppLayerBrush}" CornerRadius="5">
                    <TextBlock x:Name="CurrentVersionText" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="v1.1" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Click="OnAddFilesClick" ToolTipService.ToolTip="Bilder auswählen (Strg+O)">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" /><TextBlock x:Name="HeaderAddText" Text="Bilder hinzufügen" /></StackPanel>
                </Button>
                <Button x:Name="HeaderFolderButton" Click="OnAddFolderClick" ToolTipService.ToolTip="Kompletten Ordner öffnen">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" /><TextBlock Text="Ordner" /></StackPanel>
                </Button>
                <Button x:Name="HeaderExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnExportSelectedClick" ToolTipService.ToolTip="Ausgewählte Bilder exportieren (Strg+E)">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" /><TextBlock Text="Exportieren" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="TopNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Bearbeiten &amp; Exportieren" Icon="Edit" Tag="editor" />
                <NavigationViewItem Content="Umbenennen" Icon="Rename" Tag="rename" />
                <NavigationViewItem Content="Einstellungen" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
        </NavigationView>

        <InfoBar
            x:Name="UpdateInfoBar"
            Grid.Row="2"
            Margin="12,0,12,10"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational"
            Title="Update verfügbar">
            <InfoBar.Content>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateInfoText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="InstallUpdateButton" Grid.Column="1" Click="OnInstallUpdateClick" Content="Jetzt installieren" />
                </Grid>
            </InfoBar.Content>
        </InfoBar>

        <Grid x:Name="WorkspaceGrid" Grid.Row="3" Margin="12,0,12,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImagesColumn" Width="325" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                <ColumnDefinition x:Name="OptionsColumn" Width="390" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Bilder" />
                            <TextBlock x:Name="SelectionCountText" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="0 ausgewählt" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnClearListClick" ToolTipService.ToolTip="Liste leeren"><FontIcon Glyph="&#xE74D;" /></Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,12" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnSelectAllClick" Content="Alle" />
                        <Button Click="OnSelectNoneClick" Content="Keine" />
                    </StackPanel>
                    <ListView
                        x:Name="ImageList"
                        Grid.Row="2"
                        IsItemClickEnabled="True"
                        ItemClick="OnImageItemClick"
                        ItemsSource="{x:Bind Images, Mode=OneWay}"
                        SelectionMode="Single"
                        ContainerContentChanging="OnImageContainerContentChanging">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <Border Grid.Column="1" Width="96" Height="70" Background="#171717" CornerRadius="7"><Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" /></Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FileName}" />
                                        <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding MetadataLine}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding FileSizeText}" />
                                        <TextBlock Foreground="{ThemeResource AppSuccessBrush}" Text="{Binding LastExportText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" FontSize="20" FontWeight="SemiBold" Text="Vorschau" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewSubtitle" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Wähle ein Bild aus" />
                        </StackPanel>
                        <StackPanel x:Name="CropToolbar" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnUndoClick" ToolTipService.ToolTip="Rückgängig (Strg+Z)"><FontIcon Glyph="&#xE7A7;" /></Button>
                            <Button Click="OnRedoClick" ToolTipService.ToolTip="Wiederholen (Strg+Y)"><FontIcon Glyph="&#xE7A6;" /></Button>
                            <Button Click="OnResetCropClick" ToolTipService.ToolTip="Zuschnitt zurücksetzen (R)"><FontIcon Glyph="&#xE72C;" /></Button>
                        </StackPanel>
                    </Grid>
                    <controls:CropEditor x:Name="CropEditor" Grid.Row="1" MinHeight="340" CropChanged="OnCropChanged" />
                    <Grid x:Name="ZoomControls" Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8A3;" />
                        <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="50" Maximum="400" StepFrequency="1" Value="100" ValueChanged="OnZoomSliderChanged" />
                        <TextBlock x:Name="ZoomValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="100 %" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="ExportScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="ExportPanel" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Export vorbereiten" />
                                <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Jede Einstellung steht jetzt genau dort, wo sie wirkt." TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource StepTitleStyle}" Text="1  Größe &amp; Zuschnitt" />
                                    <ComboBox x:Name="PresetCombo" Header="Schnellauswahl (optional)" HorizontalAlignment="Stretch" PlaceholderText="Preset wählen" SelectionChanged="OnPresetChanged" />
                                    <ComboBox x:Name="ModeCombo" Header="Was soll mit der Bildgröße passieren?" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged" />
                                    <TextBlock x:Name="ModeHelpText" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Border Padding="10" Background="{ThemeResource AppLayerBrush}" CornerRadius="7">
                                        <Grid RowSpacing="3">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Originalpixel" />
                                            <TextBlock x:Name="OriginalDimensionsText" Grid.Column="1" FontWeight="SemiBold" Text="–" />
                                            <TextBlock Grid.Row="1" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Seitenverhältnis" />
                                            <TextBlock x:Name="OriginalAspectText" Grid.Row="1" Grid.Column="1" Text="–" />
                                        </Grid>
                                    </Border>
                                    <Grid x:Name="SizeFields" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox x:Name="WidthBox" Header="Max. Breite" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeChanged" />
                                        <TextBlock Grid.Column="1" Margin="0,30,0,0" VerticalAlignment="Center" FontSize="18" Text="×" />
                                        <NumberBox x:Name="HeightBox" Grid.Column="2" Header="Max. Höhe" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeChanged" />
                                    </Grid>
                                    <TextBlock x:Name="CropSizeHint" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Das Verhältnis der Zielpixel bestimmt die Form des Zuschnitts. Den Rahmen kannst du direkt im Bild an allen Seiten ziehen." TextWrapping="Wrap" />
                                    <CheckBox x:Name="AspectLockCheck" Checked="OnAspectLockChanged" Content="Breite und Höhe gekoppelt ändern" Unchecked="OnAspectLockChanged" />
                                    <CheckBox x:Name="PreventUpscaleCheck" Click="OnExportSettingChanged" Content="Kleinere Bilder nicht künstlich vergrößern" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource StepTitleStyle}" Text="2  Format &amp; Kompression" />
                                    <ComboBox x:Name="FormatCombo" Header="Ausgabeformat" HorizontalAlignment="Stretch" SelectionChanged="OnExportSettingChanged" />
                                    <TextBlock x:Name="FormatHelpText" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="QualityLabelText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Qualität" />
                                        <NumberBox x:Name="QualityBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" ValueChanged="OnQualityBoxChanged" />
                                    </Grid>
                                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" StepFrequency="1" ValueChanged="OnQualitySliderChanged" />
                                    <StackPanel x:Name="QualityPresetPanel" Orientation="Horizontal" Spacing="6">
                                        <Button Click="OnQualityPresetClick" Content="Klein" Tag="72" />
                                        <Button Click="OnQualityPresetClick" Content="Ausgewogen" Tag="82" />
                                        <Button Click="OnQualityPresetClick" Content="Sehr gut" Tag="92" />
                                    </StackPanel>
                                    <ComboBox x:Name="TransparencyCombo" Header="Hintergrund / Transparenz" HorizontalAlignment="Stretch" SelectionChanged="OnExportSettingChanged" />
                                    <TextBlock x:Name="TransparencyHelpText" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Expander Header="Metadaten und Datenschutz">
                                        <StackPanel Padding="0,8,0,2" Spacing="6">
                                            <ComboBox x:Name="MetadataCombo" Header="Metadaten" HorizontalAlignment="Stretch" SelectionChanged="OnExportSettingChanged" />
                                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Für möglichst kleine Web-Dateien: Alles entfernen. GPS sollte vor dem Teilen mindestens entfernt werden." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsGroupStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource StepTitleStyle}" Text="3  Speichern" />
                                    <ComboBox x:Name="NamingModeCombo" Header="Dateinamen" HorizontalAlignment="Stretch" SelectionChanged="OnNamingModeChanged" />
                                    <Grid x:Name="NamingFields" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="NamingPrefixBox" Header="Präfix" TextChanged="OnExportSettingChanged" />
                                        <NumberBox x:Name="NamingStartBox" Grid.Column="1" Header="Start" Minimum="0" ValueChanged="OnExportSettingChanged" />
                                        <NumberBox x:Name="NamingLengthBox" Grid.Column="2" Header="Stellen" Minimum="1" Maximum="8" ValueChanged="OnExportSettingChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DestinationBox" Header="Zielordner" IsReadOnly="True" />
                                        <Button Grid.Column="1" Margin="0,24,0,0" Click="OnChooseDestinationClick" ToolTipService.ToolTip="Zielordner wählen"><FontIcon Glyph="&#xE8B7;" /></Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Padding="14" Background="{ThemeResource AppSummaryBrush}" BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1" CornerRadius="9">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OutputSummaryText" FontWeight="SemiBold" Text="Voraussichtliche Ausgabe" />
                                        <ProgressRing x:Name="EstimateProgressRing" Grid.Column="1" Width="16" Height="16" IsActive="False" />
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Original" /><TextBlock x:Name="OriginalSizeText" Grid.Column="1" Text="–" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Exportpixel" /><TextBlock x:Name="OutputPixelText" Grid.Column="1" Text="–" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Dateigröße" /><TextBlock x:Name="EstimatedSizeText" Grid.Column="1" Text="–" /></Grid>
                                    <TextBlock x:Name="EstimateHintText" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnExportCurrentClick" Content="Nur aktuelles Bild exportieren" />
                            <Button HorizontalAlignment="Stretch" Click="OnExportSelectedClick" Content="Ausgewählte Bilder exportieren" />
                            <Button HorizontalAlignment="Stretch" Click="OnExportAllClick" Content="Alle Bilder exportieren" />
                            <Button x:Name="CancelExportButton" HorizontalAlignment="Stretch" Click="OnCancelExportClick" Content="Export abbrechen" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="RenameScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Umbenennen" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Änderungen werden immer zuerst als Vorschau angezeigt." TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Einzelne Datei" />
                            <TextBox x:Name="SingleRenameBox" Header="Neuer Dateiname" />
                            <Button HorizontalAlignment="Stretch" Click="OnPreviewSingleRenameClick" Content="Einzelvorschau" />
                            <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource AppBorderBrush}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Automatische Nummerierung" />
                            <TextBox x:Name="RenamePrefixBox" Header="Präfix" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="RenameStartBox" Header="Startnummer" Minimum="0" /><NumberBox x:Name="RenameLengthBox" Grid.Column="1" Header="Nummernlänge" Minimum="1" Maximum="8" /></Grid>
                            <ComboBox x:Name="RenameSortCombo" Header="Reihenfolge" HorizontalAlignment="Stretch" />
                            <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnPreviewRenameClick" Content="Vorschau erstellen" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Einstellungen" />
                            <ComboBox x:Name="ThemeCombo" Header="Darstellung" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" />
                            <ToggleSwitch x:Name="RestoreSessionToggle" Header="Letzte Sitzung wiederherstellen" OnContent="An" OffContent="Aus" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Öffnet beim nächsten Start wieder vorhandene Bilder, Auswahl und Zuschnitte." TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="AutoUpdateToggle" Header="Automatisch nach Updates suchen" OnContent="An" OffContent="Aus" />
                            <Button HorizontalAlignment="Stretch" Click="OnCheckUpdateClick" Content="Jetzt nach Update suchen" />
                            <NumberBox x:Name="ParallelismBox" Header="Parallele Export-Jobs" Maximum="8" Minimum="1" SpinButtonPlacementMode="Compact" />
                            <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Bei sehr großen HEIC-Dateien sind 2–4 parallele Jobs meist sinnvoll." TextWrapping="Wrap" />
                            <Rectangle Height="1" Margin="0,8" Fill="{ThemeResource AppBorderBrush}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Diagnose" />
                            <Button HorizontalAlignment="Stretch" Click="OnOpenLogsClick" Content="Log-Ordner öffnen" />
                            <Button HorizontalAlignment="Stretch" Click="OnOpenDiagnosticsClick" Content="Diagnose-Ordner öffnen" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Padding="16,0" Background="{ThemeResource AppCardBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" Margin="0,0,10,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="Bereit" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="ExportProgressBar" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <Button x:Name="ResultsButton" Grid.Column="3" Padding="10,4" Click="OnShowResultsClick" Visibility="Collapsed"><TextBlock x:Name="ResultsButtonText" Text="Ergebnisse" /></Button>
        </Grid>
    </Grid>
</Window>
